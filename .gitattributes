# Shell scripts must keep LF endings — several run inside Alpine containers
# (postgres:16-alpine, entrypoint scripts) that lack CRLF-tolerant shells.
# A Windows checkout without this rule silently breaks container init scripts.
*.sh text eol=lf

# The Gradle wrapper is extensionless, so *.sh doesn't cover it. It runs inside
# the Linux backend build image (COPY gradlew; RUN ./gradlew), where a CRLF
# shebang (#!/usr/bin/env sh\r) makes the interpreter "not found" → exit 127.
gradlew text eol=lf
# The Windows-side wrapper must stay CRLF.
gradlew.bat text eol=crlf

# Scripts with a #! shebang, invoked directly rather than via `python`/etc.
*.py text eol=lf
